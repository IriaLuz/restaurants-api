# Copy this file to ".env" (cp .env.example .env). The app reads it when it starts.
# Never commit your real ".env": it's in .gitignore.

# Where the database lives: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://practice:practice@localhost:5432/restaurants

# The database the integration tests use. It gets wiped before every test!
TEST_DATABASE_URL=postgresql://practice:practice@localhost:5432/restaurants_test

PORT=3000
